{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["@codemod.com/jssg-types", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["tests"]
}
