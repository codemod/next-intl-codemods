{
  "name": "next-intl-codemods",
  "version": "0.1.0",
  "private": true,
  "description": "Codemod toolkit packages for next-intl migrations",
  "type": "module",
  "scripts": {
    "test": "pnpm -r --if-present --filter './codemods/**' test",
    "check-types": "pnpm -r --if-present --filter './codemods/**' run check-types",
    "ci": "pnpm run check-types && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0"
}
